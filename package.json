{
  "name": "ownspire-little-one",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "verify": "npm run verify:purity && npm run verify:protocol && npm run verify:tool-protocol && npm run verify:driver && npm run verify:registry && npm run verify:migration && npm run verify:config-api && npm run verify:magpie",
    "verify:purity": "node --import tsx scripts/verify-protocol-purity.ts",
    "verify:protocol": "node --import tsx scripts/protocol/verify-turn.ts",
    "verify:driver": "node --import tsx scripts/drivers/verify-vercel-ai.ts",
    "verify:registry": "node --import tsx scripts/registry/verify-registry.ts",
    "verify:migration": "node --import tsx scripts/registry/verify-migration.ts",
    "verify:gateway": "node --import tsx scripts/verify-gateway.ts",
    "verify:stream": "node --import tsx scripts/verify-stream.ts",
    "verify:tool-protocol": "node --import tsx scripts/protocol/verify-tool-protocol.ts",
    "verify:config-api": "node --import tsx scripts/protocol/verify-config-api.ts",
    "verify:magpie": "node --import tsx scripts/verify-magpie-process.ts",
    "verify:claude": "node --import tsx scripts/drivers/verify-claude.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "ai": "7.0.60",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "description": "The Little One Inside the Flask — 业务无关的 Agent Runtime"
}
