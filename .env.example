# 环境变量。复制成 .env 后填写。

# ---- 必填 ---------------------------------------------------------------

# 鉴权token，raven 的 BFF 带着它调本服务。至少 16 字符。
# 换掉它等于让 raven 重新配置 —— 那是它的用途。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AGENT_RUNTIME_TOKEN=

# 模型 key。**变量名由厂商决定** —— 见下面的「模型厂商」。
OPENAI_API_KEY=

# ---- 模型厂商 -----------------------------------------------------------
#
# ⚠️ **这里改过架构，别照老文档配。**（2026-10-09 实测踩过）
#
# 现在**厂商 / 端点 / 模型目录在数据库里**（providers / endpoints / models 三张表，
# 启动时幂等写入），环境变量只负责两件事：
#
#   1. **提供 key**——每个厂商有自己的变量名，由 `providers.keyEnvVar` 决定
#   2. **指定默认模型** —— `AGENT_MODEL`
#
# 所以**没有** `AGENT_OPENAI_BASE_URL`、也没有 `AGENT_MODELS`：
# 端点 URL 在 `endpoints` 表里，模型清单由 `GET /api/models` 从库里出。
#
# ⚠️ **key 填错变量名是最容易犯的错**，症状是「启动时提示某个厂商未设置，
#    然后请求带着一把空 key 打过去」，报错说 key 无效，而真正的原因是填错了地方：
#
#   openai    → OPENAI_API_KEY
#   zhipu     → ZHIPU_API_KEY      ← **glm-* 属于这个厂商**
#   deepseek  → DEEPSEEK_API_KEY
#
# 用智谱 GLM 就填：
ZHIPU_API_KEY=
AGENT_MODEL=glm-5.3

# ⚠️ **GLM 必须显式设这个**，代码会自动带上 `thinking: {type:'enabled'}`，
#    但 `reasoning_effort` 只有显式配了才带 —— 省掉就是用智谱的默认值（max，最贵）。
#
#    low  简单问答、最快、最低成本
#    high 标准编码、推理任务
#    max  复杂 Agent、深度推理（智谱默认值，也最贵）
AGENT_REASONING_EFFORT=high

# ⚠️ 配了库里没有的模型会**直接抛错拒绝启动**（不静默退到别的模型）。
#    「我明明设了 glm-5.3 却用的是 deepseek」那种坑就是这么被堵住的。
#
# 换厂商只改这三处：key 的变量名、AGENT_MODEL、以及库里的端点指向。

# ---- 其他厂商的示例 ------------------------------------------------------
#
# DeepSeek：
#   DEEPSEEK_API_KEY=...
#   AGENT_MODEL=deepseek-chat
#
# OpenAI 官方：
#   OPENAI_API_KEY=...
#   AGENT_MODEL=gpt-5

# ---- 可选 ---------------------------------------------------------------

AGENT_PORT=5900

# ⚠️ **默认的 `./data/agent.db` 在这台机器上写不了**（SQLite 报 `disk I/O error`，
#    而报错误指着「磁盘」而不是「这个目录建不了 journal」）。所以本机请写绝对路径，
#    放home 下（raven / atlas 的数据目录也在那儿）。
AGENT_DB_FILE=/Users/你的用户名/.local/share/ownspire-little-one/agent.db
# ⚠️ 别写 `$HOME/...` —— **dotenv 不做变量展开**，那个 `$HOME` 会被当成一个
#    真实目录名，在工作区里建出「$HOME/.local/share/...」这么一棵树。

# raven 的反向 gateway（raven 侧也要配同一个值）。
# 没配的话 raven.* 工具会调用失败，但 echo / add / removeFile 仍可用。
RAVEN_URL=http://127.0.0.1:5800
RAVEN_GATEWAY_TOKEN=

# 7 位 commit，infra 的 deploy 用它判断「跑的是哪一版」。
# 本地开发留空即可，会返回 dev0000。
# AGENT_VERSION=