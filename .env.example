# 环境变量。复制成 .env 后填写。
#
# 厂商 key、协议（Chat / Responses / Messages）和推理档位配在 Magpie 里。
# little-one 只向 Magpie 发 OpenAI Chat Completions。

# ---- 必填 ---------------------------------------------------------------

# 鉴权 token，raven 的 BFF 带着它调本服务。至少 16 字符。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AGENT_RUNTIME_TOKEN=

# Magpie 上的模型名或路由组，例如 zhipu/glm-5.3。会话不另存一份。
MAGPIE_MODEL=

# ---- 可选 ---------------------------------------------------------------

AGENT_PORT=5900

# Magpie 的 Chat Completions 根地址与调用 token。默认指向本机 magpie serve。
# MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
# MAGPIE_API_KEY=magpie
# MAGPIE_AUTOSTART=0

# ⚠️ 默认的 `./data/agent.db` 在这台机器上写不了（SQLite 报 disk I/O error）。
#    本机请写绝对路径。别写 `$HOME/...` —— dotenv 不做变量展开。
AGENT_DB_FILE=/Users/你的用户名/.local/share/ownspire-little-one/agent.db

# raven 的反向 gateway（raven 侧也要配同一个值）。
# 没配的话 raven.* 工具会调用失败，但 echo / add / removeFile 仍可用。
RAVEN_URL=http://127.0.0.1:5800
RAVEN_GATEWAY_TOKEN=

# 7 位 commit，infra 的 deploy 用它判断「跑的是哪一版」。
# 本地开发留空即可，会返回 dev0000。
# AGENT_VERSION=
