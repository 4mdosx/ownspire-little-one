# 环境变量。复制成 .env 后填写。

# ---- 必填 ---------------------------------------------------------------

# 鉴权token，raven 的 BFF 带着它调本服务。至少 16 字符。
# 换掉它等于让 raven 重新配置 —— 那是它的用途。
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AGENT_RUNTIME_TOKEN=

# 模型 key。
OPENAI_API_KEY=

# ---- 模型厂商 -----------------------------------------------------------
#
# ⚠️ `@ai-sdk/openai` 同时覆盖 OpenAI 与所有 OpenAI 兼容端点，
#    所以**换厂商只改这几个变量，不改代码**。
#
# 变量名保持 OPENAI_API_KEY 是刻意的 —— 插件在读它，改名就得改代码。

# 智谱 GLM（OpenAI 兼容端点）
AGENT_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENT_MODEL=glm-5.3

# ⚠️ **GLM 必须显式设这个**，代码会自动带上 `thinking: {type:'enabled'}`，
#    但 `reasoning_effort` 只有显式配了才带 —— 省掉就是用智谱的默认值（max，最贵）。
#
#    low  简单问答、最快、最低成本
#    high 标准编码、推理任务
#    max  复杂 Agent、深度推理（智谱默认值，也最贵）
AGENT_REASONING_EFFORT=high

# 模型清单（前端会话创建页显示）。逗号分隔，格式 `id` 或 `id=显示名`。
# ⚠️ 不要硬编码在代码里 —— 列一份与实际端点不符的清单比不列更糟：
#   用户会选了才发现用不了。省略时只给AGENT_MODEL 那一个。
AGENT_MODELS=glm-5.3,glm-5.3-flash=快速版

# ---- 其他厂商的示例 ------------------------------------------------------
#
# DeepSeek：
#   AGENT_OPENAI_BASE_URL=https://api.deepseek.com/v1
#   AGENT_MODEL=deepseek-chat
#   AGENT_MODELS=deepseek-chat,deepseek-reasoner=深度思考
#
# OpenAI 官方（注释掉 baseURL 即可）：
#   AGENT_MODEL=gpt-5
#   AGENT_MODELS=gpt-5,gpt-5-mini

# ---- 可选 ---------------------------------------------------------------

AGENT_PORT=5900
AGENT_DB_FILE=./data/agent.db

# raven 的反向 gateway（raven 侧也要配同一个值）。
# 没配的话 raven.* 工具会调用失败，但 echo / add / removeFile 仍可用。
RAVEN_URL=http://127.0.0.1:5800
RAVEN_GATEWAY_TOKEN=

# 7 位 commit，infra 的 deploy 用它判断「跑的是哪一版」。
# 本地开发留空即可，会返回 dev0000。
# AGENT_VERSION=